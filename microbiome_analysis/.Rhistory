library(phyloseq)
library(corncob)
library(plyr)
library(dplyr)
library(reshape2)
library(tibble)
library(ggplot2)
writeLines(capture.output(sessionInfo()), "sessionInfo.txt")
otu <- read.table("silva_nochloronomito_otu_table_ps1_corncob.txt",sep="\t",header=TRUE, row.names=1)
taxon <- read.table("silva_nochloronomito_taxa_table_ps1_corncob.txt",sep="\t",header=TRUE,row.names=1)
samples<-read.table("metadata_ps1.txt",sep="\t",header=T,row.names=1)
OTU = otu_table(otu, taxa_are_rows=FALSE)
taxon<-as.matrix(taxon)
TAX = tax_table(taxon)
sampledata = sample_data(samples)
ps1 <- phyloseq(otu_table(otu, taxa_are_rows=FALSE),
sample_data(samples),
tax_table(taxon))
ps1
otu <- read.table("silva_nochloronomito_otu_table_psS_ATEN_FT.txt",sep="\t",header=TRUE, row.names=1)
otu <- read.table("silva_nochloronomito_otu_table_psA_ATEN_FT.txt",sep="\t",header=TRUE, row.names=1)
taxon <- read.table("silva_nochloronomito_taxa_table_psA_ATEN_FT.txt",sep="\t",header=TRUE,row.names=1)
samples<-read.table("metadata_ps1.txt",sep="\t",header=T,row.names=1)
OTU = otu_table(otu, taxa_are_rows=FALSE)
taxon<-as.matrix(taxon)
TAX = tax_table(taxon)
sampledata = sample_data(samples)
psA <- phyloseq(otu_table(otu, taxa_are_rows=FALSE),
sample_data(samples),
tax_table(taxon))
psA
# remove samples from "before" timepoint
psA2 = subset_samples(psA2, Timepoint =! "before")
# remove samples from "before" timepoint
psA2 = subset_samples(psA, Timepoint =! "before")
otu <- read.table("silva_nochloronomito_otu_table_psA_ATEN_FT.txt",sep="\t",header=TRUE, row.names=1)
taxon <- read.table("silva_nochloronomito_taxa_table_psA_ATEN_FT.txt",sep="\t",header=TRUE,row.names=1)
samples<-read.table("metadata_ps1.txt",sep="\t",header=T,row.names=1)
OTU = otu_table(otu, taxa_are_rows=FALSE)
taxon<-as.matrix(taxon)
TAX = tax_table(taxon)
sampledata = sample_data(samples)
psA <- phyloseq(otu_table(otu, taxa_are_rows=FALSE),
sample_data(samples),
tax_table(taxon))
psA
# remove samples from "before" timepoint
psA2 = subset_samples(psA, Timepoint != "before")
psA2 #
psA2 <- prune_taxa(taxa_sums(psA2) > 1, psA2) #remove taxa not found in remaining samples
psA2
View(samples)
View(sampledata)
View(sampledata)
View(samples)
# DA determined relative to first reference level, so set this manually: positive estimates will be enriched in the recovery period relative to during low oxygen
sample_data(psA2)$Timepoint<-factor(sample_data(psA2)$Timepoint,levels=c("during","after"))
set.seed(1)
recovery.da <- differentialTest(formula = ~ Timepoint,
phi.formula = ~ Timepoint,
formula_null = ~ 1,
phi.formula_null = ~ Timepoint,
test = "Wald", boot = FALSE,
data = psA2,
fdr_cutoff = 0.05)
recovery.da$significant_taxa
#quick look at results with corncob's plotting feature
plot(recovery.da, level="Genus") # lists by genus
extractmods <- function(model) {
result <- data.frame("Estimate" = model$coefficients[2, 1],
"Std.Error" = model$coefficients[2, 2],
"p" = model$coefficients[2, 4])
return(result)
}
# save the timepoint.da output and add asv, p.adj values to it, and ultimately taxonomy info
recovery.da.models <- lapply(recovery.da$significant_models, extractmods)
names(recovery.da.models) <- recovery.da$significant_taxa
# Add ASVs to the taxonomy table and save the significant asvs
tax_table(psA2)[,7] <- rownames(tax_table(psA2))
sig.taxonomy.recovery <- as.data.frame(tax_table(psA2)[recovery.da$significant_taxa,])
# Move the data from a list to a dataframe and add taxonomy info
recovery.da.models.df <- ldply(recovery.da.models, data.frame) %>%
left_join(sig.taxonomy.recovery, by = c(".id" = "sequence")) %>%
mutate(family_asv = paste0(Family, "_(", .id,")"))
### Save these data so you don't have to re-run the model ###
write.table(recovery.da.models.df, "DA_ASV_recovery-ATEN.txt", sep="\t",row.names = FALSE)
otu <- read.table("silva_nochloronomito_otu_table_psS_SSID_FT.txt",sep="\t",header=TRUE, row.names=1)
taxon <- read.table("silva_nochloronomito_taxa_table_psS_SSID_FT.txt",sep="\t",header=TRUE,row.names=1)
samples<-read.table("metadata_ps1.txt",sep="\t",header=T,row.names=1)
OTU = otu_table(otu, taxa_are_rows=FALSE)
taxon<-as.matrix(taxon)
TAX = tax_table(taxon)
sampledata = sample_data(samples)
psS <- phyloseq(otu_table(otu, taxa_are_rows=FALSE),
sample_data(samples),
tax_table(taxon))
psS
psS2 = subset_samples(psS, Timepoint != "before")
psS2
psS2 <- prune_taxa(taxa_sums(psS2) > 1, psS2) #remove taxa not found in remaining samples
psS2
sample_data(psS2)$Timepoint<-factor(sample_data(psS2)$Timepoint,levels=c("during","after"))
set.seed(1)
recovery.da <- differentialTest(formula = ~ Timepoint,
phi.formula = ~ Timepoint,
formula_null = ~ 1,
phi.formula_null = ~ Timepoint,
test = "Wald", boot = FALSE,
data = psS2,
fdr_cutoff = 0.05)
recovery.da$significant_taxa #  differential abundant ASV out of 1707
#quick look at results with corncob's plotting feature
plot(recovery.da, level="Genus") # lists by genus
extractmods <- function(model) {
result <- data.frame("Estimate" = model$coefficients[2, 1],
"Std.Error" = model$coefficients[2, 2],
"p" = model$coefficients[2, 4])
return(result)
}
# save the timepoint.da output and add asv, p.adj values to it, and ultimately taxonomy info
recovery.da.models <- lapply(recovery.da$significant_models, extractmods)
names(recovery.da.models) <- recovery.da$significant_taxa
# Add ASVs to the taxonomy table and save the significant asvs
tax_table(psS2)[,7] <- rownames(tax_table(psS2))
sig.taxonomy.recovery <- as.data.frame(tax_table(psS2)[recovery.da$significant_taxa,])
# Move the data from a list to a dataframe and add taxonomy info
recovery.da.models.df <- ldply(recovery.da.models, data.frame) %>%
left_join(sig.taxonomy.recovery, by = c(".id" = "sequence")) %>%
mutate(family_asv = paste0(Family, "_(", .id,")"))
### Save these data so you don't have to re-run the model ###
write.table(recovery.da.models.df, "DA_ASV_recovery-SSID.txt", sep="\t",row.names = FALSE)
